# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment and secrets (the documented template is safe to commit)
.env
.env.*
!.env.example
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
secrets.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases and Prisma artifacts
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/dev.db*
/src/generated/prisma/

# test and tooling output
/test-results/
/playwright-report/
/.vitest/
/.turbo/

# editor and local tooling
.idea/
.vscode/*
!.vscode/settings.json
*.swp
Thumbs.db
