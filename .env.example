# Copy this file to .env for Docker/Prisma development and change the password.
# These values are local placeholders only; never use them for a hosted database.
POSTGRES_USER="copper_spoon"
POSTGRES_PASSWORD="replace-with-a-local-only-password"
POSTGRES_DB="copper_spoon"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://copper_spoon:replace-with-a-local-only-password@localhost:5433/copper_spoon?schema=public"
DATABASE_POOL_MAX="5"

# Generate a unique local value before using staff authentication.
AUTH_SECRET="replace-with-a-locally-generated-secret"
AUTH_URL="http://localhost:3000"
# Use a separate, random value of at least 32 characters in hosted environments.
RATE_LIMIT_SECRET="replace-with-a-unique-rate-limit-secret"

# One-time development admin provisioning. Set these only when running the
# explicit command, then remove/unset them. Never commit real credentials.
ADMIN_PROVISION_NAME="Fictional Demo Admin"
ADMIN_PROVISION_EMAIL="admin@copperspoon.example"
ADMIN_PROVISION_PASSWORD="replace-with-a-unique-development-password"

# Production provisioning is intentionally not templated here. Supply its mode,
# confirmation, and credentials only to the one-time production command.
